{
  "name": "i18n-feater",
  "version": "1.0.3",
  "description": "Lightweight instance-based i18n for TypeScript.",
  "type": "module",
  "keywords": [
    "i18n",
    "intl",
    "localization",
    "translate"
  ],
  "homepage": "https://github.com/DevNyanHa/i18n-feater#readme",
  "bugs": {
    "url": "https://github.com/DevNyanHa/i18n-feater/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevNyanHa/i18n-feater.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "scripts": {
    "build": "clean.bat && npm update && tsc",
    "b": "npm run build",
    "test": "node dist/i18n.test.js",
    "t": "npm run test",
    "check": "npm run build && npm run test",
    "c": "npm run check"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
